{"number":1,"name":"Al-Faatiha","nameTr":"The Opening","ayahCount":7,"firstPage":1,"lastPage":1,"verses":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","tr":"Rahman ve Rahim olan Allah'ın adıyla:","lt":"Bismillaahir Rahmaanir Raheem","p":1},{"n":2,"ar":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","tr":"Hamd, Alemlerin Rabbi Allah'a mahsustur.","lt":"Alhamdu lillaahi Rabbil 'aalameen","p":1},{"n":3,"ar":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","tr":"O Rahman ve Rahim'dir,","lt":"Ar-Rahmaanir-Raheem","p":1},{"n":4,"ar":"مَٰلِكِ يَوْمِ ٱلدِّينِ","tr":"Din Gününün sahibidir.","lt":"Maaliki Yawmid-Deen","p":1},{"n":5,"ar":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","tr":"Ancak Sana kulluk eder ve yalnız Senden yardım dileriz.","lt":"Iyyaaka na'budu wa lyyaaka nasta'een","p":1},{"n":6,"ar":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","tr":"Bizi doğru yola eriştir.","lt":"Ihdinas-Siraatal-Mustaqeem","p":1},{"n":7,"ar":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","tr":"Nimete erdirdiğin kimselerin yoluna; gazaba uğrayanların, ya da sapıtanların yoluna değil.","lt":"Siraatal-lazeena an'amta 'alaihim ghayril-maghdoobi 'alaihim wa lad-daaalleen","p":1}]}