{"number":101,"name":"Al-Qaari'a","nameTr":"The Calamity","ayahCount":11,"firstPage":600,"lastPage":600,"verses":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","tr":"Gürültü koparacak olan","lt":"Al qaari'ah","p":600},{"n":2,"ar":"مَا ٱلْقَارِعَةُ","tr":"Nedir o gürültü koparacak olan?","lt":"Mal qaariah","p":600},{"n":3,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","tr":"O gürültü koparacak olanın ne olduğunu sen bilir misin?","lt":"Wa maa adraaka mal qaari'ah","p":600},{"n":4,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","tr":"O gün insanlar, ateş etrafında çırpınıp dökülen pervaneye dönecekler.","lt":"Yauma ya koonun naasu kal farashil mabthooth","p":600},{"n":5,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","tr":"Dağlar, atılmış renkli yüne benzeyecekler.","lt":"Wa ta koonul jibalu kal 'ihnil manfoosh","p":600},{"n":6,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","tr":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır.","lt":"Fa-amma man thaqulat mawa zeenuh","p":600},{"n":7,"ar":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","tr":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır.","lt":"Fahuwa fee 'ishatir raadiyah","p":600},{"n":8,"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","tr":"Tartıları hafif gelenler ise,","lt":"Wa amma man khaffat mawa zeenuh","p":600},{"n":9,"ar":"فَأُمُّهُۥ هَاوِيَةٌۭ","tr":"Onların yeri bir çukurdur.","lt":"Fa-ummuhu haawiyah","p":600},{"n":10,"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","tr":"O çukurun ne olduğunu sen bilir misin?","lt":"Wa maa adraaka maa hiyah","p":600},{"n":11,"ar":"نَارٌ حَامِيَةٌۢ","tr":"O, kızgın bir ateştir.","lt":"Naarun hamiyah","p":600}]}