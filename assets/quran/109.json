{"number":109,"name":"Al-Kaafiroon","nameTr":"The Disbelievers","ayahCount":6,"firstPage":603,"lastPage":603,"verses":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","tr":"De ki: \"Ey inkarcılar!\"","lt":"Qul yaa-ai yuhal kaafiroon","p":603},{"n":2,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","tr":"\"Ben sizin taptıklarınıza tapmam.\"","lt":"Laa a'budu ma t'abudoon","p":603},{"n":3,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"\"Benim taptığıma da sizler tapmazsınız.\"","lt":"Wa laa antum 'aabidoona maa a'bud","p":603},{"n":4,"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","tr":"\"Ben de sizin taptığınıza tapacak değilim.\"","lt":"Wa laa ana 'abidum maa 'abattum","p":603},{"n":5,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"\"Benim taptığıma da sizler tapmıyorsunuz.\"","lt":"Wa laa antum 'aabidoona ma a'bud","p":603},{"n":6,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","tr":"\"Sizin dininiz size, benim dinim banadır.\"","lt":"Lakum deenukum wa liya deen.","p":603}]}