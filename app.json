{
  "expo": {
    "name": "Hilal",
    "slug": "hilal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "hilal",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karakaya.hilal",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Namaz vakitlerini bulunduğunuz konuma göre hesaplamak için konumunuza ihtiyaç duyuyoruz.",
        "NSMotionUsageDescription": "Kıble yönünü doğru tayin edebilmek için pusula ve hareket sensörlerine ihtiyaç duyuyoruz."
      }
    },
    "android": {
      "package": "com.karakaya.hilal",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#102D27",
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NidaWidget",
              "label": "Hilal · Dinamik Akıllı Widget",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "description": "Dinamik Akilli Namaz Vakti Widget'i",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NidaSmallWidget",
              "label": "Hilal · Vakit & Geri Sayım (Küçük)",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "180dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "none",
              "description": "Siradaki vakit ve kalan sure sayaci",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NidaMediumWidget",
              "label": "Hilal · Vakit & Ayet / Hadis / Dua (Orta)",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "description": "Siradaki vakit, geri sayim ve vaktin ayet/hadis/duasi",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NidaLargeWidget",
              "label": "Hilal · İmsakiye, Geri Sayım & Ayet / Hadis / Dua (Büyük)",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "description": "Tam gunluk imsakiye seridi, geri sayim ve vaktin ayeti/hadisi/duasi",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Namaz vakitlerini bulunduğunuz konuma göre hesaplamak için konumunuza ihtiyaç duyuyoruz.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981",
          "defaultChannel": "prayer-reminders"
        }
      ],
      "expo-sensors",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class * extends androidx.work.Worker { *; }\n-keep class androidx.work.impl.WorkDatabase* { *; }\n-keep class com.reactnativeandroidwidget.** { *; }"
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#102D27",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "d56532a3-85a7-45ff-94de-075a78d6e7c7"
      }
    },
    "owner": "defaceshs-team"
  }
}